# FRONTEND_PORT=5173
# BACKEND_PORT=3000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite (used when no MYSQL_HOST is set)
SQLITE_DB_LOCATION=./todo.db

# MySQL (used when MYSQL_HOST is set)
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=

# Each MySQL variable above also supports a "_FILE" variant
# MYSQL_HOST_FILE=
# MYSQL_PORT_FILE=
# MYSQL_USER_FILE=
# MYSQL_PASSWORD_FILE=
# MYSQL_DB_FILE=
