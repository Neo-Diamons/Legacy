# Copy this file to .env and fill in real values.
# Keep this file in sync whenever a new variable is introduced.

# SQLite (used when no MYSQL_HOST is set)
SQLITE_DB_LOCATION=./todo.db

# MySQL (used when MYSQL_HOST is set)
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DB=

# Each MySQL variable above also supports a "_FILE" variant
# MYSQL_HOST_FILE=
# MYSQL_USER_FILE=
# MYSQL_PASSWORD_FILE=
# MYSQL_DB_FILE=