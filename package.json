{
  "name": "legacy-todolist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write backend frontend eslint.config.js",
    "format:check": "prettier --check backend frontend eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "tar": "7.5.4",
    "glob": "11.1.0",
    "semver": "7.5.2",
    "cross-spawn": "7.0.5",
    "braces": "3.0.3",
    "http-cache-semantics": "4.1.1",
    "socks": "2.8.1"
  }
}
