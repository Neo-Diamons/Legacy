{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@db": ["./src/db/index.ts"],
      "@db/*": ["./src/db/*"],
      "@model/*": ["./src/model/*"],
      "@service/*": ["./src/service/*"],
      "@controller/*": ["./src/controller/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
