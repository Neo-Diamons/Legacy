{
  "name": "@legacy/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --import tsx src/index.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps --env-file-if-exists=../.env dist/index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts && MYSQL_HOST=localhost drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts && MYSQL_HOST=localhost drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "node --env-file-if-exists=../.env ../node_modules/.bin/drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "mysql2": "^3.24.4",
    "wait-port": "^1.1.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "tsdown": "^0.16.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
