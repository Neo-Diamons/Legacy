{
  "name": "@legacy/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env index.ts",
    "start": "tsx --env-file-if-exists=../.env index.ts",
    "test": "node --env-file-if-exists=.env.test --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.sqlite.ts && drizzle-kit generate --config=drizzle.config.mysql.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.sqlite.ts && drizzle-kit migrate --config=drizzle.config.mysql.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "mysql2": "^3.16.1",
    "uuid": "^13.0.0",
    "wait-port": "^1.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
  }
}
