{
  "name": "@legacy/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "test": "node --env-file-if-exists=.env.test ../node_modules/vitest/vitest.mjs run",
    "db:generate": "drizzle-kit generate --config=drizzle.config.sqlite.ts && drizzle-kit generate --config=drizzle.config.mysql.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.sqlite.ts && drizzle-kit migrate --config=drizzle.config.mysql.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "mysql2": "^3.16.1",
    "uuid": "^13.0.0",
    "wait-port": "^1.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
